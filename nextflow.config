// ─── Pipeline metadata ──────────────────────────────────────────────
manifest {
    name            = 'uniprot-parquet'
    mainScript      = 'upjson2lake.nf'
    nextflowVersion = '>=26.04'    // upjson2lake.nf is written in the strict syntax
    version         = '1.0.0'
    description     = 'UniProtKB JSON → sorted Parquet data lake'
}

// ─── Params the config itself reads ─────────────────────────────────
// The config is evaluated before the script, so a default that lives only
// in upjson2lake.nf is still null here.  Keep identical to the script.
params.outdir = "${projectDir}/results/uniprot_parquet"

// ─── Diagnostic reports (enabled by default for troubleshooting) ────
// Written to ${params.outdir}/reports/ so they don't clutter the launch dir.
// Fixed file names, so overwrite on every run (-resume re-runs would
// otherwise keep the stale reports and warn "Failed to render").
timeline.enabled   = true
timeline.overwrite = true
timeline.file      = "${params.outdir}/reports/timeline.html"
report.enabled     = true
report.overwrite   = true
report.file        = "${params.outdir}/reports/report.html"
trace.enabled      = true
trace.overwrite    = true
trace.file         = "${params.outdir}/reports/trace.txt"
dag.enabled        = true
dag.overwrite      = true
dag.file           = "${params.outdir}/reports/dag.html"

profiles {
    local {
        process.executor = 'local'
    }
    prod {
        process {
            executor = 'slurm'
            errorStrategy = 'finish'
            queue = 'production'
            // Defaults for processes that set nothing themselves (a process's
            // own directive wins).  Plain values: a `{ task.time ?: '1d' }`
            // closure recurses into itself for a process without `time`.
            memory = '16 GB'
            time = '1d'
            cpus = 1
            beforeScript = '''
                  echo "SLURM Job ID: $SLURM_JOB_ID"
            '''
            clusterOptions = {
                def base = '--mail-type=FAIL,REQUEUE,INVALID_DEPEND,ARRAY_TASKS'
                params.notify_email ? "${base} --mail-user=${params.notify_email}" : base
            }
            // OOM retry with doubled memory for SORT_JSONL / PARQUET_TRANSFORM
            // is declared on the processes in upjson2lake.nf (every profile).
        }
    }
    short {
        process {
            executor = 'slurm'
            errorStrategy = 'finish'
            queue = 'short'
            memory = '4 GB'
            time = '4h'
            cpus = 1
            // The short queue's wall-time cap also applies to the heavy
            // processes, which ask for 24-48h for the full dataset (a
            // withName setting overrides the process's own directive).
            withName: 'STREAM_JSONL|SORT_JSONL|PARQUET_TRANSFORM' {
                time = '4h'
            }
            beforeScript = '''
                  echo "SLURM Job ID: $SLURM_JOB_ID"
            '''
            clusterOptions = {
                def base = '--mail-type=FAIL,REQUEUE,INVALID_DEPEND,ARRAY_TASKS'
                params.notify_email ? "${base} --mail-user=${params.notify_email}" : base
            }
        }
    }
}
